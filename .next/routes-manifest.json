      "namedRegex": "^/savings\\-calculator(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/",
      "dataRouteRegex": "^/_next/data/0RH66HszjHsTcg52ZmyiG/index\\.json$"
    },
    {
      "page": "/about",
      "dataRouteRegex": "^/_next/data/0RH66HszjHsTcg52ZmyiG/about\\.json$"
    },
    {
      "page": "/advanced-calculator",
      "dataRouteRegex": "^/_next/data/0RH66HszjHsTcg52ZmyiG/advanced-calculator\\.json$"
    },
    {
      "page": "/basic-calculator",
      "dataRouteRegex": "^/_next/data/0RH66HszjHsTcg52ZmyiG/basic-calculator\\.json$"
    },
    {
      "page": "/contact",
